    {
      "name": "ESP32_TASTER_SCHALTER",
      "kind": "functionBlock",
      "header": "class ESP32_TASTER_SCHALTER {\npublic:\n    // Local variables\n    R_TRIG R_TRIG0;\n    // Inputs\n    IEC_BOOL IN1;\n    IEC_BOOL PB_SW;\n    IEC_BOOL NO_NC;\n    // Outputs\n    IEC_BOOL OUT;\n    // Local variables\n    IEC_BOOL _TMP_NOT9185098_OUT;\n    IEC_BOOL _TMP_NOT3736476_OUT;\n    IEC_BOOL _TMP_AND2797410_OUT;\n    IEC_BOOL _TMP_AND3481250_OUT;\n    IEC_BOOL _TMP_OR6374086_OUT;\n    IEC_BOOL _TMP_AND2110482_OUT;\n    IEC_BOOL _TMP_XOR5882055_OUT;\n    IEC_BOOL _TMP_NOT1687859_OUT;\n    IEC_BOOL _TMP_AND2932436_OUT;\n    IEC_BOOL _TMP_OR5624662_OUT;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    ESP32_TASTER_SCHALTER();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~ESP32_TASTER_SCHALTER() = default;\n};\n",
      "cpp": "ESP32_TASTER_SCHALTER::ESP32_TASTER_SCHALTER()\n    : PB_SW(0), NO_NC(0)\n{\n    // Initialize variables\n}\n\nvoid ESP32_TASTER_SCHALTER::operator()() {\n    _TMP_NOT9185098_OUT = NOT(IN1);\n    _TMP_NOT3736476_OUT = NOT(NO_NC);\n    _TMP_AND2797410_OUT = AND(_TMP_NOT9185098_OUT, _TMP_NOT3736476_OUT);\n    _TMP_AND3481250_OUT = AND(IN1, NO_NC);\n    _TMP_OR6374086_OUT = OR(_TMP_AND2797410_OUT, _TMP_AND3481250_OUT);\n    _TMP_AND2110482_OUT = AND(_TMP_OR6374086_OUT, PB_SW);\n    R_TRIG0.CLK = _TMP_AND2110482_OUT;\n    R_TRIG0();\n    R_TRIG0.ENO = true;\n    _TMP_XOR5882055_OUT = XOR(R_TRIG0.Q, _TMP_XOR5882055_OUT);\n    _TMP_NOT1687859_OUT = NOT(PB_SW);\n    _TMP_AND2932436_OUT = AND(_TMP_OR6374086_OUT, _TMP_NOT1687859_OUT);\n    _TMP_OR5624662_OUT = OR(_TMP_XOR5882055_OUT, _TMP_AND2932436_OUT);\n    OUT = _TMP_OR5624662_OUT;\n}\n",
      "deps": [
        {
          "library": "iec-standard-fb",
          "name": "R_TRIG"
        },
